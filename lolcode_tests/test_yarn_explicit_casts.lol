
HAI
    WAZZUP
        I HAS A numString ITZ "123"
        I HAS A floatString ITZ "3.14"
        I HAS A trueString ITZ "WIN"
        I HAS A emptyString ITZ ""
        I HAS A zeroString ITZ "0"
        I HAS A resultNumbr
        I HAS A resultNumbar
        I HAS A resultTroof1
        I HAS A resultTroof2
        I HAS A resultTroof3
    BUHBYE

    resultNumbr R MAEK numString A NUMBR
    resultNumbar R MAEK floatString A NUMBAR
    resultTroof1 R MAEK trueString A TROOF
    resultTroof2 R MAEK emptyString A TROOF
    resultTroof3 R MAEK zeroString A TROOF

    VISIBLE resultNumbr
    VISIBLE resultNumbar
    VISIBLE resultTroof1
    VISIBLE resultTroof2
    VISIBLE resultTroof3
KTHXBYE
